<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>ndt_cuda</name>
  <version>0.1.0</version>
  <description>
    CUDA accelerated Normal Distributions Transform (NDT) point cloud registration.
    GPU port of the PCL / koide3/ndt_omp NDT with the same API (drop-in replacement for
    pclomp::NormalDistributionsTransform).
  </description>

  <maintainer email="melike.153t@gmail.com">Melike</maintainer>
  <license>BSD-3-Clause</license>
  <license>Apache-2.0</license>  <!-- multigrid_ndt_cuda.hpp, impl/multigrid_ndt_cuda.hpp, ndt_struct.hpp -->

  <url type="repository">https://github.com/meliketanrikulu/ndt_cuda</url>
  <url type="bugtracker">https://github.com/meliketanrikulu/ndt_cuda/issues</url>

  <author>Melike</author>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>eigen</depend>
  <depend>libpcl-all-dev</depend>

  <!-- The CUDA toolkit (>= 11.4, CUDA 12.x recommended) must be installed on the system;
       there is no rosdep key that covers every platform (desktop / Jetson). -->

  <test_depend>git</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
